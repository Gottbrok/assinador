{
  "manifest_version": 3,
  "name": "Assinador (prova de native messaging)",
  "description": "Extensão de medição da F0: confere se o navegador lança o programa e se o programa alcança a leitora. Não é o produto.",
  "version": "0.0.1",
  "key": "",
  "permissions": ["nativeMessaging"],
  "action": { "default_popup": "pagina.html", "default_title": "Prova do Assinador" },
  "browser_specific_settings": {
    "gecko": { "id": "prova-assinador@confidata.com.br", "strict_min_version": "115.0" }
  }
}
